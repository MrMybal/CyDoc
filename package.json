{
  "name": "cydoc",
  "version": "0.1.0",
  "description": "Lightweight, modular, multilingual documentation for apps. Works locally without a web server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrMybal/CyDoc.git"
  },
  "homepage": "https://mrmybal.github.io/CyDoc/",
  "bugs": {
    "url": "https://github.com/MrMybal/CyDoc/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/modules",
    "dist/viewer.css",
    "src/viewer.css",
    "web",
    "tools",
    "LICENSE",
    "README.md",
    "README.fr.md",
    "VERSION.md",
    "VERSION.fr.md",
    "assets/branding/cydoc-logo-v1.png",
    "website/assets/screenshots/reader-guide.webp",
    "website/assets/screenshots/studio-visual.webp",
    "AGENTS.md",
    "llms.txt",
    "ai",
    "examples/integrations",
    "examples/api"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./viewer.css": "./dist/viewer.css",
    "./modules/image": {
      "types": "./dist/modules/image.d.ts",
      "import": "./dist/modules/image.js"
    },
    "./modules/video": {
      "types": "./dist/modules/video.d.ts",
      "import": "./dist/modules/video.js"
    },
    "./modules/mesh": {
      "types": "./dist/modules/mesh.d.ts",
      "import": "./dist/modules/mesh.js"
    },
    "./modules/gallery": {
      "types": "./dist/modules/gallery.d.ts",
      "import": "./dist/modules/gallery.js"
    },
    "./modules/graph": {
      "types": "./dist/modules/graph.d.ts",
      "import": "./dist/modules/graph.js"
    },
    "./modules/gif": {
      "types": "./dist/modules/gif.d.ts",
      "import": "./dist/modules/gif.js"
    },
    "./api-import": "./tools/api-import.mjs",
    "./compiler": "./tools/compiler.mjs",
    "./extract": "./tools/extract.mjs"
  },
  "bin": {
    "cydoc": "tools/cli.mjs"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "tsc && node tools/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "size": "node tools/size.mjs",
    "website:build": "npm run build && node website/build.mjs",
    "website:preview": "node website/preview.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "marked": "^17.0.1",
    "esbuild": "^0.25.12",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "three": "^0.187.0",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4"
  }
}
